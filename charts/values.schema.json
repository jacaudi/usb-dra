{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "common": {
      "description": "Helm injects the common dependency's own defaults under its chart name. Nothing here reads them: common.yaml renders from a fresh dict.",
      "type": "object"
    },
    "global": {
      "description": "Required by common's name helpers. Only labels and annotations are accepted: every name override would let an object drift from the service account the admission policy guards.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "labels": { "type": "object", "additionalProperties": { "type": "string" } },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "driver": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "excludeClasses": {
          "description": "Comma-separated USB interface classes, two lowercase hex digits each, as --exclude-classes validates them.",
          "type": "string",
          "pattern": "^([0-9a-f]{2}(,[0-9a-f]{2})*)?$"
        },
        "include": {
          "description": "Devices published despite excludeClasses, each vid:pid or vid:pid:serial, as --include validates them.",
          "type": "array",
          "items": { "type": "string", "pattern": "^[0-9a-f]{4}:[0-9a-f]{4}(:.+)?$" }
        },
        "rescanInterval": {
          "description": "A Go duration greater than zero.",
          "type": "string",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))*([0-9]*[1-9][0-9]*(\\.[0-9]+)?|[0-9]+\\.[0-9]*[1-9][0-9]*)(ns|us|µs|ms|s|m|h)([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))*$"
        },
        "verbosity": { "type": "integer", "minimum": 0, "maximum": 10 },
        "cdiRoot": { "description": "A clean absolute path: it is interpolated into the DaemonSet args and a hostPath, which must agree.", "type": "string", "pattern": "^/[A-Za-z0-9._/-]*$" }
      }
    },
    "deviceClasses": {
      "description": "Key -> DeviceClass \"<key>.usb.jacaudi.dev\". The key must be a DNS label. Hex IDs are four lowercase hex digits and must be quoted in YAML: an unquoted 1e03 or 0403 is a number, which is rejected rather than rendered into a wrong selector. There are no default classes; null removes a class an earlier values file defined.",
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
      "additionalProperties": {
        "type": ["object", "null"],
        "additionalProperties": false,
        "required": ["vendor", "products"],
        "properties": {
          "vendor": { "type": "string", "pattern": "^[0-9a-f]{4}$" },
          "products": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[0-9a-f]{4}$" }
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": { "type": "object", "additionalProperties": { "type": ["string", "number"] } },
        "limits": { "type": "object", "additionalProperties": { "type": ["string", "number"] } }
      }
    },
    "nodeSelector": { "type": "object", "additionalProperties": { "type": "string" } },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string" },
          "operator": { "type": "string", "enum": ["Equal", "Exists"] },
          "value": { "type": "string" },
          "effect": { "type": "string", "enum": ["NoSchedule", "PreferNoSchedule", "NoExecute"] },
          "tolerationSeconds": { "type": "integer" }
        }
      }
    },
    "priorityClassName": { "type": "string" }
  }
}
